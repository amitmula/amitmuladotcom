# Use the official Nginx image (alpine is lightweight)
FROM nginx:alpine

# Remove the default Nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy the custom Nginx configuration file
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the static website files (index.html) into the Nginx web root
COPY index.html /usr/share/nginx/html/index.html

# FIX: Change ownership of the web root to the 'nginx' user/group.
# This resolves the "Permission denied" error (code 13) since the Nginx
# worker process runs as this user.
RUN chown -R nginx:nginx /usr/share/nginx/html

# Expose port 80 (default for Nginx)
EXPOSE 80

# Command to run Nginx (inherited from base image)
CMD ["nginx", "-g", "daemon off;"]
